# ─── MIC-CC · .gitignore ──────────────────────────────────────────────

# ── Raw data (large files, not versioned) ─────────────────────────────
data/raw/**/*.csv
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.json
data/raw/**/*.zip
!data/raw/**/.gitkeep

# ── Working paper drafts ───────────────────────────────────────────────
working_paper/drafts/
*.docx
*.doc

# ── Credentials & environment ──────────────────────────────────────────
.env
*.env
secrets.py
credentials.json
token.json
api_keys.txt

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── OS ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ── IDE ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Power BI (binary, not diff-able) ──────────────────────────────────
*.pbix
*.pbit

# ── Large outputs (regenerated by notebooks) ──────────────────────────
outputs/figures/**/*.png
outputs/figures/**/*.pdf
!outputs/figures/**/.gitkeep

# ── NOTE: data/processed/ IS tracked ──────────────────────────────────
# Small curated CSVs (top10, resumen fletes, puertos consolidado, etc.)
# are version-controlled for reproducibility
!data/processed/
!data/processed/**/*.csv
